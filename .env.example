# Fresh setup can generate this file on both nodes: ./setup.sh --worker user@worker --apply
# It discovers cache paths from model IDs; manual configuration below remains supported.
# GLM-5.3-Flash native TP2: copy this file to .env ON EACH NODE.
# Values are literal: do not use $HOME, ~, command substitution or references
# to another variable. Bash, Docker Compose and settings.py read this file.
# Replace every /home/your-user path and the example addresses below.
# Keep the two .env files separate; never copy the head's .env onto the worker.

# --- Node identity: REQUIRED edits ---
# Head: ROLE=head, NODE_RANK=0, VLLM_HOST_IP=<head LAN IPv4>.
# Worker: ROLE=worker, NODE_RANK=1, VLLM_HOST_IP=<worker LAN IPv4>.
# HEAD_HOST is the SAME head LAN IPv4 on both nodes.
ROLE=head
NODE_RANK=0
HEAD_HOST=10.10.0.1
VLLM_HOST_IP=10.10.0.1

# One IPv4 selector per RoCE port: CIDR network, dotted prefix or exact address.
# Each selector must match exactly one local address on a distinct interface.
# Existing prefixes remain supported; host netmasks do not need changing.
FABRIC_SUBNETS='10.20.0. 10.21.0.'
# Adjacent /30 example: FABRIC_SUBNETS='192.168.2.0/30 192.168.2.4/30'

# --- Image and deployment location: REQUIRED edits ---
# Pull this published patched ARM64 GB10 image on BOTH nodes before startup.
IMAGE=technigmaai/glm-5.3-flash-gb10-tp2-native:c748079-displaykv1-arm64-cu130
# Absolute directory containing this node's compose.yaml and files/entrypoint.sh.
DEPLOY_ROOT=/home/your-user/Development/ai-tools/glm-5.3-flash-gb10-tp2-native
PROJECT_NAME=glm53-native
CONTAINER_NAME=glm53-native

# Head only: passwordless SSH destination and absolute deployment path on worker.
# Replace the username/address/path. Worker may leave both values empty.
PEER_SSH=your-user@10.20.0.2
PEER_DEPLOY_DIR=/home/your-user/Development/ai-tools/glm-5.3-flash-gb10-tp2-native

# --- Host paths: REQUIRED edits ---
# Models stay in this node user's HF hub cache, mounted read-only.
# Setup discovers this path automatically, honoring HF_HOME/HF_HUB_CACHE.
HF_HUB_HOST_DIR=/home/your-user/.cache/huggingface/hub
# Writable native cache and logs: create these directories before startup.
CACHE_HOST_DIR=/home/your-user/.cache/glm53-native
LOG_HOST_DIR=/home/your-user/.local/state/glm53-native/logs
# Fresh deployment: create this EMPTY directory; old deployment is not required.
# Optional: point it to complete, matching optimized snapshots, mounted read-only.
SNAPSHOT_SEED_DIR=/home/your-user/.cache/glm53-native/snapshot-seed
# Set to the output of: stat -c '%g' /dev/dri/card0
DRM_CARD_GID=44

# --- Pinned Hugging Face model identities: keep unchanged ---
# vLLM receives these IDs directly; only these cached revisions may be loaded.
# Startup is offline and never downloads or moves weights.
MODEL_ID=nvidia/GLM-5.3-Flash-NVFP4
MODEL_REVISION=da920bb0b9f4a06727223a349e55468e38352348
DRAFT_ID=incoai/GLM-5.3-Flash-DFlash2
DRAFT_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a
# Explicit local/flat paths remain supported; see the deployment guide.

# --- Shared serving profile: keep matching on both nodes ---
TP=2
API_PORT=8000
STATUS_PORT=8082
MASTER_PORT=29553
FABRIC_CHECK_PORT=29511
MAX_MODEL_LEN=1047552
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
KV_CACHE_MEMORY=8589934592
GPU_MEM_UTIL=0.88
TORCH_MEM_FRACTION=0.92

# Space-separated API aliases for this ONE loaded NVIDIA checkpoint.
# Additional compatibility aliases may be appended; they do not load models.
SERVED_NAME=glm53
SERVICE_NAME=glm53
MODEL_ALIASES='glm53 nvidia/GLM-5.3-Flash-NVFP4'
LIMIT_MM='{"image":32,"video":0}'
MM_PROCESSOR_CACHE_GB=1

# MiaAI-derived template with a tool-continuation reminder; reasoning defaults to max.
# enable_thinking=false closes the thinking prefix instead of selecting low effort.
CHAT_TEMPLATE=/deployment/files/chat_template.jinja

# --- GB10 headless display-memory integration ---
# Default profile requires display-manager stopped and /dev/dri/card0 accessible.
# nvidia_drm modeset must be Y/1; see docs/DEPLOYMENT.md#drm-modesetting.
# The recovered display memory is part of, not additional to, the 8 GiB KV pool.
GLM53_DISPLAY_KV_ENABLE=1
GLM53_DISPLAY_KV_MIN_BYTES=4294967296

# Optional idle-resource preflight overrides (defaults shown):
# FABRIC_MIN_DEVICES=2
# FABRIC_MTU=9000
# MIN_AVAILABLE_GIB=100
